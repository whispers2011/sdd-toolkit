{
  "name": "sdd-toolkit",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-project SDD workflow orchestrator with per-feature worktrees, consoles and an auto-resolving merge queue",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @sdd/server --filter @sdd/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "node-pty", "esbuild"],
    "overrides": {
      "esbuild": "0.25.12"
    }
  },
  "packageManager": "pnpm@10.0.0"
}
